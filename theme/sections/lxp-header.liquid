{{ 'lxp-base.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign menu = linklists[s.menu]
-%}
<lxp-header class="lxp lxp-header" data-sticky="{{ s.sticky }}">
  <div class="lxp-header__bar">
    <div class="lxp-container lxp-header__grid">

      <div class="lxp-header__icons lxp-header__icons--start">
        <button class="lxp-icon-btn lxp-header__burger" type="button" data-drawer-open aria-expanded="false" aria-controls="lxp-drawer">
          <span class="sr-only">Site navigation</span>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
        <a class="lxp-icon-btn" href="/search">
          <span class="sr-only">Search</span>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
        </a>
      </div>

      <div class="lxp-header__logo">
        <a href="/" aria-label="{{ shop.name }}">
          {%- if s.logo != blank -%}
            {{ s.logo | image_url: width: 600 | image_tag: widths: '150,300,450,600', sizes: '150px',
               loading: 'eager', alt: shop.name, class: 'lxp-header__logo-img' }}
          {%- else -%}
            <span class="lxp-header__wordmark">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      <div class="lxp-header__icons lxp-header__icons--end">
        <a class="lxp-icon-btn" href="/account">
          <span class="sr-only">Account</span>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/></svg>
        </a>
        <a class="lxp-icon-btn lxp-header__cart" href="/cart">
          <span class="sr-only">Cart</span>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5 7h14l-1.2 12.2a1.5 1.5 0 0 1-1.5 1.3H7.7a1.5 1.5 0 0 1-1.5-1.3Z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
          <span class="lxp-header__count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>

  {%- if menu.links.size > 0 -%}
    <nav class="lxp-header__nav" aria-label="Primary">
      <ul class="lxp-nav" role="list">
        {%- for link in menu.links -%}
          {%- if link.links.size > 0 -%}
            <li class="lxp-nav__item" data-mega>
              <button class="lxp-nav__link" type="button" aria-expanded="false" aria-haspopup="true">
                {{ link.title }}
              </button>

              <div class="lxp-mega" data-mega-panel hidden>
                <div class="lxp-container">
                  <ul class="lxp-mega__grid" role="list" style="--cards: {{ s.cards_per_row }};">
                    {%- for child in link.links -%}
                      {%- liquid
                        assign img = null
                        assign obj = child.object
                        if child.type == 'collection_link' and obj
                          assign img = obj.image
                          unless img
                            assign img = obj.products.first.featured_image
                          endunless
                        elsif child.type == 'product_link' and obj
                          assign img = obj.featured_image
                        endif
                        assign label = child.title | split: ' - ' | last
                      -%}
                      <li class="lxp-mega__item">
                        <a class="lxp-mega__card" href="{{ child.url }}">
                          <span class="lxp-media lxp-media--panel">
                            {%- if img -%}
                              {{ img | image_url: width: 600 | image_tag: loading: 'lazy',
                                 widths: '200,300,450,600',
                                 sizes: '(max-width:989px) 40vw, 14vw', alt: label }}
                            {%- else -%}
                              <span class="lxp-mega__blank">{{ label }}</span>
                            {%- endif -%}
                          </span>
                          <span class="lxp-mega__label">{{ label }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                  {%- if link.url != '#' and link.url != blank -%}
                    <a class="lxp-link lxp-mega__all" href="{{ link.url }}">Browse {{ link.title | downcase }}</a>
                  {%- endif -%}
                </div>
              </div>
            </li>
          {%- else -%}
            <li class="lxp-nav__item">
              <a class="lxp-nav__link" href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}

  <!-- mobile drawer -->
  <div class="lxp-drawer" id="lxp-drawer" hidden>
    <div class="lxp-drawer__scrim" data-drawer-close></div>
    <div class="lxp-drawer__panel" role="dialog" aria-modal="true" aria-label="Site navigation">
      <div class="lxp-drawer__head">
        <button class="lxp-icon-btn" type="button" data-drawer-back hidden>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
          <span class="sr-only">Back</span>
        </button>
        <span class="lxp-drawer__title" data-drawer-title></span>
        <button class="lxp-icon-btn" type="button" data-drawer-close>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
          <span class="sr-only">Close</span>
        </button>
      </div>

      <div class="lxp-drawer__views">
        <ul class="lxp-drawer__list" data-view="root" role="list">
          {%- for link in menu.links -%}
            <li>
              {%- if link.links.size > 0 -%}
                <button class="lxp-drawer__row" type="button" data-open-view="{{ forloop.index }}">
                  {{ link.title }}
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
                </button>
              {%- else -%}
                <a class="lxp-drawer__row" href="{{ link.url }}">{{ link.title }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- for link in menu.links -%}
          {%- if link.links.size > 0 -%}
            <ul class="lxp-drawer__list" data-view="{{ forloop.index }}" data-title="{{ link.title }}" role="list" hidden>
              {%- for child in link.links -%}
                <li><a class="lxp-drawer__row" href="{{ child.url }}">{{ child.title | split: ' - ' | last }}</a></li>
              {%- endfor -%}
              <li><a class="lxp-drawer__row lxp-drawer__row--all" href="{{ link.url }}">Browse all</a></li>
            </ul>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</lxp-header>

<script>
  class LxpHeader extends HTMLElement {
    connectedCallback() {
      this.openTimer = null; this.closeTimer = null;
      this.mq = window.matchMedia('(min-width: 990px)');

      // ---- desktop mega menu: hover with intent, keyboard-accessible ----
      this.querySelectorAll('[data-mega]').forEach((item) => {
        const btn = item.querySelector('.lxp-nav__link');
        const panel = item.querySelector('[data-mega-panel]');
        if (!btn || !panel) return;

        const open = () => {
          clearTimeout(this.closeTimer);
          this.openTimer = setTimeout(() => {
            this.closeAll(item);
            panel.hidden = false;
            requestAnimationFrame(() => item.classList.add('is-open'));
            btn.setAttribute('aria-expanded', 'true');
          }, 70);
        };
        const close = (immediate) => {
          clearTimeout(this.openTimer);
          this.closeTimer = setTimeout(() => {
            item.classList.remove('is-open');
            btn.setAttribute('aria-expanded', 'false');
            setTimeout(() => { if (!item.classList.contains('is-open')) panel.hidden = true; }, 220);
          }, immediate ? 0 : 140);
        };

        item.addEventListener('pointerenter', () => { if (this.mq.matches) open(); });
        item.addEventListener('pointerleave', () => { if (this.mq.matches) close(); });
        btn.addEventListener('click', () => {
          if (!this.mq.matches) return;
          item.classList.contains('is-open') ? close(true) : (clearTimeout(this.openTimer), open());
        });
        item.addEventListener('focusin', () => { if (this.mq.matches) open(); });
        item.addEventListener('focusout', (e) => {
          if (this.mq.matches && !item.contains(e.relatedTarget)) close(true);
        });
        item._close = () => close(true);
      });

      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') this.closeAll(); });

      // ---- sticky ----
      if (this.dataset.sticky === 'true') {
        const onScroll = () => this.classList.toggle('is-stuck', window.scrollY > 8);
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // ---- mobile drawer ----
      const drawer = this.querySelector('#lxp-drawer');
      const title = this.querySelector('[data-drawer-title]');
      const back = this.querySelector('[data-drawer-back]');
      const views = this.querySelectorAll('.lxp-drawer__list');

      const showView = (name) => {
        views.forEach((v) => { v.hidden = v.dataset.view !== name; });
        const active = this.querySelector('[data-view="' + name + '"]');
        const isRoot = name === 'root';
        back.hidden = isRoot;
        title.textContent = isRoot ? 'Menu' : ((active && active.dataset.title) || '');
      };
      const openDrawer = () => {
        drawer.hidden = false;
        requestAnimationFrame(() => drawer.classList.add('is-open'));
        document.documentElement.style.overflow = 'hidden';
        showView('root');
      };
      const closeDrawer = () => {
        drawer.classList.remove('is-open');
        document.documentElement.style.overflow = '';
        setTimeout(() => { drawer.hidden = true; }, 300);
      };

      const openBtn = this.querySelector('[data-drawer-open]');
      if (openBtn) openBtn.addEventListener('click', openDrawer);
      this.querySelectorAll('[data-drawer-close]').forEach((b) => b.addEventListener('click', closeDrawer));
      if (back) back.addEventListener('click', () => showView('root'));
      this.querySelectorAll('[data-open-view]').forEach((b) =>
        b.addEventListener('click', () => showView(b.dataset.openView))
      );
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !drawer.hidden) closeDrawer();
      });
    }

    closeAll(except) {
      this.querySelectorAll('[data-mega]').forEach((i) => { if (i !== except && i._close) i._close(); });
    }
  }
  if (!customElements.get('lxp-header')) customElements.define('lxp-header', LxpHeader);
</script>

{% stylesheet %}
  .lxp-header { position: sticky; top: 0; z-index: 40; display: block;
    background: var(--lxp-bg); border-bottom: 1px solid transparent; transition: border-color .25s ease, box-shadow .25s ease; }
  .lxp-header.is-stuck { border-bottom-color: var(--lxp-border-light); box-shadow: 0 1px 20px rgb(0 0 0 / .04); }

  .lxp-header__grid { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; padding-block: 1.15rem; }
  .lxp-header__icons { display: flex; align-items: center; gap: .35rem; }
  .lxp-header__icons--end { justify-content: flex-end; }
  .lxp-header__logo { display: flex; justify-content: center; }
  .lxp-header__logo-img { display: block; max-height: 46px; max-width: 150px; width: auto; height: auto; object-fit: contain; }
  .lxp-header__wordmark { font-weight: 700; letter-spacing: .12em; text-transform: uppercase; font-size: 1rem; }

  .lxp-icon-btn { display: inline-flex; align-items: center; justify-content: center; position: relative;
    width: 2.5rem; height: 2.5rem; border: 0; background: none; color: var(--lxp-fg); cursor: pointer;
    border-radius: var(--lxp-radius-full); transition: background .2s ease; }
  .lxp-icon-btn:hover { background: rgb(23 23 23 / .06); }
  .lxp-header__count { position: absolute; top: .25rem; right: .2rem; min-width: 1.05rem; height: 1.05rem;
    display: grid; place-items: center; padding: 0 .25rem; border-radius: var(--lxp-radius-full);
    background: var(--lxp-fg); color: var(--lxp-bg); font-size: .625rem; font-weight: 600; }

  /* ---- desktop nav ---- */
  .lxp-header__nav { display: none; border-top: 1px solid var(--lxp-border-light); }
  @media (min-width: 990px) { .lxp-header__nav { display: block; } .lxp-header__burger { display: none; } }
  .lxp-nav { display: flex; justify-content: center; gap: 2.25rem; margin: 0; padding: 0; list-style: none; }
  .lxp-nav__item { position: static; }
  .lxp-nav__link { display: inline-flex; align-items: center; gap: .4rem; padding: .9rem 0;
    border: 0; background: none; cursor: pointer; color: var(--lxp-fg); text-decoration: none;
    font-family: inherit; font-size: .8125rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
  .lxp-nav__link::after { content: ""; position: absolute; }
  .lxp-nav__item > .lxp-nav__link { position: relative; }
  .lxp-nav__item > .lxp-nav__link::before { content: ""; position: absolute; left: 0; right: 0; bottom: .55rem;
    height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left;
    transition: transform .35s cubic-bezier(.3,1,.3,1); }
  .lxp-nav__item:hover > .lxp-nav__link::before,
  .lxp-nav__item.is-open > .lxp-nav__link::before { transform: scaleX(1); }

  /* ---- mega panel ---- */
  .lxp-mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--lxp-bg);
    border-top: 1px solid var(--lxp-border-light); box-shadow: 0 24px 40px rgb(0 0 0 / .07);
    padding-block: 2rem 2.25rem; opacity: 0; transform: translateY(-8px);
    transition: opacity .28s ease, transform .32s cubic-bezier(.3,1,.3,1); pointer-events: none; }
  .lxp-nav__item.is-open .lxp-mega { opacity: 1; transform: none; pointer-events: auto; }
  .lxp-mega__grid { display: grid; grid-template-columns: repeat(var(--cards, 6), 1fr); gap: 1rem;
    margin: 0; padding: 0; list-style: none; }
  .lxp-mega__item { opacity: 0; transform: translateY(6px); transition: opacity .3s ease, transform .3s ease; }
  .lxp-nav__item.is-open .lxp-mega__item { opacity: 1; transform: none; }
  .lxp-mega__item:nth-child(1) { transition-delay: .02s } .lxp-mega__item:nth-child(2) { transition-delay: .05s }
  .lxp-mega__item:nth-child(3) { transition-delay: .08s } .lxp-mega__item:nth-child(4) { transition-delay: .11s }
  .lxp-mega__item:nth-child(5) { transition-delay: .14s } .lxp-mega__item:nth-child(6) { transition-delay: .17s }
  .lxp-mega__card { display: block; text-decoration: none; color: inherit; }
  .lxp-mega__card .lxp-media { display: block; box-shadow: inset 0 0 0 1px var(--lxp-border-light); }
  .lxp-mega__card .lxp-media > img { transition: transform .8s cubic-bezier(.3,1,.3,1); }
  .lxp-mega__card:hover .lxp-media > img { transform: scale(1.06); }
  .lxp-mega__label { display: block; margin-top: .6rem; font-size: .6875rem; font-weight: 500;
    letter-spacing: .12em; text-transform: uppercase; }
  .lxp-mega__blank { position: absolute; inset: 0; display: grid; place-items: center; padding: 1rem;
    text-align: center; font-size: .6875rem; font-weight: 500; letter-spacing: .12em;
    text-transform: uppercase; color: var(--lxp-muted); }
  .lxp-mega__all { display: inline-block; margin-top: 1.75rem; }

  /* ---- mobile drawer ---- */
  .lxp-drawer { position: fixed; inset: 0; z-index: 60; }
  .lxp-drawer__scrim { position: absolute; inset: 0; background: rgb(13 13 13 / .45);
    opacity: 0; transition: opacity .3s ease; }
  .lxp-drawer.is-open .lxp-drawer__scrim { opacity: 1; }
  .lxp-drawer__panel { position: absolute; inset-block: 0; left: 0; width: min(88vw, 380px);
    background: var(--lxp-bg); display: flex; flex-direction: column;
    transform: translateX(-100%); transition: transform .34s cubic-bezier(.3,1,.3,1); }
  .lxp-drawer.is-open .lxp-drawer__panel { transform: none; }
  .lxp-drawer__head { display: flex; align-items: center; justify-content: space-between; gap: .5rem;
    padding: .75rem .75rem .75rem 1rem; border-bottom: 1px solid var(--lxp-border-light); }
  .lxp-drawer__title { font-size: .75rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  .lxp-drawer__views { flex: 1; overflow-y: auto; }
  .lxp-drawer__list { margin: 0; padding: .5rem 0; list-style: none; }
  .lxp-drawer__row { display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    width: 100%; padding: .95rem 1.25rem; border: 0; background: none; cursor: pointer;
    color: var(--lxp-fg); text-decoration: none; font-family: inherit; text-align: left;
    font-size: .875rem; font-weight: 500; letter-spacing: .04em; }
  .lxp-drawer__row:hover { background: rgb(23 23 23 / .04); }
  .lxp-drawer__row--all { color: var(--lxp-muted); }
  @media (min-width: 990px) { .lxp-drawer { display: none; } }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  @media (prefers-reduced-motion: reduce) {
    .lxp-mega, .lxp-mega__item, .lxp-drawer__panel, .lxp-drawer__scrim { transition-duration: .01ms !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LXP header",
  "tag": "header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "range", "id": "cards_per_row", "label": "Mega menu cards per row", "min": 3, "max": 8, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
