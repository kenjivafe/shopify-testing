{{ 'lxp-base.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="lxp lxp-section lxp-split{% if s.media_position == 'right' %} lxp-split--flip{% endif %}{% if s.dark %} lxp-split--dark{% endif %}">
  <div class="lxp-container lxp-split__grid">
    <div class="lxp-media lxp-media--wide lxp-split__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1800 | image_tag: loading: 'lazy',
           widths: '600,900,1200,1800', sizes: '(max-width:989px) 100vw, 50vw',
           alt: s.image.alt | default: s.heading }}
      {%- endif -%}
    </div>
    <div class="lxp-split__body">
      {%- if s.eyebrow != blank -%}<p class="lxp-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="lxp-h2">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="lxp-body lxp-split__text">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}
        <a class="lxp-btn{% if s.dark %} lxp-btn--light{% endif %}" href="{{ s.button_link | default: '/collections/all' }}">{{ s.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .lxp-split--dark { background: var(--lxp-fg); color: #fff; }
  .lxp-split--dark .lxp-eyebrow { color: rgb(255 255 255 / 0.6); }
  .lxp-split--dark .lxp-body { color: rgb(255 255 255 / 0.75); }
  .lxp-split__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 4rem); align-items: center; }
  .lxp-split--flip .lxp-split__media { order: 2; }
  .lxp-split__body { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .lxp-split__text { max-width: 46ch; }
  .lxp-split__body .lxp-btn { margin-top: 0.5rem; }
  @media (max-width: 989px) {
    .lxp-split__grid { grid-template-columns: 1fr; }
    .lxp-split--flip .lxp-split__media { order: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LXP split",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "media_position", "label": "Image position",
      "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
  ],
  "presets": [{ "name": "LXP split" }]
}
{% endschema %}
