{
  "type": "header",
  "name": "t:names.header",
  "sections": {
    "announcement": {
      "type": "header-announcements",
      "blocks": {
        "a1": {
          "type": "_announcement",
          "settings": {
            "text": "Free shipping across the UAE · Authorised NOVITEC, SPOFEC and TechArt partner",
            "font": "var(--font-subheading--family)",
            "font_size": "0.75rem",
            "letter_spacing": "normal",
            "case": "none"
          }
        }
      },
      "block_order": ["a1"],
      "name": "t:names.announcement_bar",
      "settings": {
        "speed": 5,
        "section_width": "page-width",
        "background_color": "{{ settings.color_palette.foreground }}",
        "divider_width": 0,
        "divider_color": "{{ settings.color_palette.color2 }}",
        "padding-block-start": 10,
        "padding-block-end": 10
      }
    },
    "lxp_header": {
      "type": "lxp-header",
      "settings": {
        "logo": "shopify://shop_images/lxp-logo.png",
        "menu": "main-menu",
        "cards_per_row": 6,
        "sticky": true
      }
    }
  },
  "order": ["announcement", "lxp_header"]
}
