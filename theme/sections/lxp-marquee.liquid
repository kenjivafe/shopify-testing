{{ 'lxp-base.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section class="lxp lxp-marquee{% if s.dark %} lxp-marquee--dark{% endif %}" style="--speed: {{ s.speed }}s;">
  <div class="lxp-marquee__track">
    {%- for i in (1..4) -%}
      <span class="lxp-marquee__item" {% if i > 1 %}aria-hidden="true"{% endif %}>{{ s.text }}</span>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .lxp-marquee { overflow: hidden; padding-block: 1.15rem; border-block: 1px solid var(--lxp-border-light);
    background: var(--lxp-bg); color: var(--lxp-fg); }
  .lxp-marquee--dark { background: var(--lxp-fg); color: #fff; border-color: transparent; }
  .lxp-marquee__track { display: flex; width: max-content; gap: 2.5rem; will-change: transform;
    animation: lxp-marquee var(--speed) linear infinite; }
  .lxp-marquee__item { font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.16em;
    text-transform: uppercase; white-space: nowrap; }
  @keyframes lxp-marquee { to { transform: translate3d(calc(-50% - 1.25rem), 0, 0); } }
  @media (prefers-reduced-motion: reduce) { .lxp-marquee__track { animation: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "LXP marquee",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Novitec — Spofec — TechArt — FI Exhaust — Liberty Walk —" },
    { "type": "checkbox", "id": "dark", "label": "Dark band", "default": true },
    { "type": "range", "id": "speed", "label": "Speed", "min": 10, "max": 90, "step": 5, "unit": "s", "default": 40 }
  ],
  "presets": [{ "name": "LXP marquee" }]
}
{% endschema %}
